# Must exist; photos retain original names directly inside this directory.
CAMERA_STORAGE_ROOT=/path/to/backup/Camera
# Optional, recommended for removable disks. Must be a mounted ancestor of the root.
CAMERA_MOUNT_ROOT=/path/to/mounted/disk
# Keep the private index outside the photo archive, in an existing local directory.
CAMERA_INDEX_PATH=/path/to/local/state/inventory.sqlite3
CAMERA_TOKEN=replace-with-a-random-secret
CAMERA_HOST=127.0.0.1
CAMERA_PORT=8789

# Additional existing destinations; successful delivery is remembered if imports move.
CAMERA_COPY_PATHS=["/path/to/photoprism/import"]

# Optional additional collections when running the service directly.
# WHATSAPP_IMAGES_STORAGE_ROOT=/path/to/archive/whatsapp-images
# WHATSAPP_IMAGES_INDEX_PATH=/path/to/state/whatsapp-images.sqlite3
# WHATSAPP_VIDEOS_STORAGE_ROOT=/path/to/archive/whatsapp-videos
# WHATSAPP_VIDEOS_INDEX_PATH=/path/to/state/whatsapp-videos.sqlite3
