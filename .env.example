# Copy to `.env` and fill in your own server. `.env` is gitignored.
PHOTOSYNC_SERVER_URL=https://photoprism.example.com/import/
PHOTOSYNC_USERNAME=admin

# Camera container: existing flat archive, separate random secret and HTTPS endpoint
CAMERA_ARCHIVE_PATH=/path/to/backup/Camera
CAMERA_TOKEN=replace-with-a-random-secret
CAMERA_PUBLIC_URL=https://photosync.internal.example.com

# PhotoPrism delivery directory, independent from archive backups.
PHOTOPRISM_IMPORT_PATH=/path/to/photoprism/import

# Independent archives; subfolders are preserved.
WHATSAPP_IMAGES_ARCHIVE_PATH=/path/to/archive/whatsapp-images
WHATSAPP_VIDEOS_ARCHIVE_PATH=/path/to/archive/whatsapp-videos
